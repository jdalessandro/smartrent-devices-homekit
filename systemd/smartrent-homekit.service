[Unit]
Description=SmartRent devices bridged to Apple HomeKit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/smartrent-devices-homekit
# After `smartrent-homekit-setup init`, credentials live in ./smartrent.env next to devices.json:
EnvironmentFile=-/home/pi/smartrent-devices-homekit/smartrent.env
# Optional extra vars (HAP persist path, etc.):
EnvironmentFile=-/etc/default/smartrent-homekit
ExecStart=/home/pi/smartrent-devices-homekit/.venv/bin/python -m smartrent_homekit
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
